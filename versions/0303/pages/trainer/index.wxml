<view class="page">
  <view class="title">节律训练</view>
  <view class="subtitle">
    容忍窗 {{tolMs}}ms ｜Stage1：固定BPM｜Stage2：DDA自适应
  </view>

  <!-- Mode Switch -->
  <view class="modeRow">
    <button class="modeBtn {{mode==='stage1'?'active':''}}" bindtap="setMode" data-mode="stage1" disabled="{{isRunning}}">Stage 1</button>
    <button class="modeBtn {{mode==='stage2'?'active':''}}" bindtap="setMode" data-mode="stage2" disabled="{{isRunning}}">Stage 2</button>
  </view>

  <view class="card">
    <!-- Stage1 Config -->
    <view wx:if="{{mode==='stage1'}}">
      <view class="row">
        <view class="label">BPM：{{bpm}}</view>
        <slider min="60" max="80" step="1" value="{{bpm}}" bindchange="onBpmChange" disabled="{{isRunning}}"/>
      </view>
      <view class="tip">60秒一轮，命中率 ≥ 70% 解锁 Stage2</view>
    </view>

    <!-- Stage2 Config -->
    <view wx:if="{{mode==='stage2'}}">
      <view class="row">
        <view class="label">bpm_cur：{{bpmCur}}｜range：{{range}}</view>
      </view>
      <view class="tip">
        每10次点击更新一次难度：根据 acc10 & mean_err 调整 bpm_cur / range
      </view>
    </view>

    <!-- Metronome -->
    <view class="metronome">
      <!-- 固定尺寸透明舞台：无圆环/无脉冲，仅承载猴子 -->
      <view class="metronomeStage">
        <drum-character hitSeq="{{drumHitSeq}}"></drum-character>
      </view>

      <view class="hint">{{isRunning ? '跟着节拍点下面按钮' : '设置好后开始'}}</view>
    </view>

    <!-- Buttons -->
    <view class="btnRow">
      <button class="btn" type="primary" bindtap="onStart" disabled="{{isRunning}}">
        开始 {{durationSec}} 秒
      </button>
      <button class="btn" bindtap="onStop" disabled="{{!isRunning}}">停止</button>
    </view>

    <!-- Tap -->
    <view class="tapArea">
      <button class="tapBtn" bindtap="onTapBeat" disabled="{{!isRunning}}">点我打拍</button>
    </view>

    <!-- Live Stats -->
    <view class="stats">
      <view class="stat">剩余：{{remainingSec}}s</view>
      <view class="stat">Beats：{{beatCount}}</view>
      <view class="stat">命中：{{hitCount}}</view>
      <view class="stat">命中率：{{accuracyPct}}%</view>
      <view class="stat">最近误差：{{lastErrMs}}ms</view>
    </view>

    <!-- Stage2 Live DDA Stats -->
    <view class="stats" wx:if="{{mode==='stage2'}}">
      <view class="stat">acc10：{{acc10Pct}}%</view>
      <view class="stat">mean_err(10)：{{meanErr10}}ms</view>
      <view class="stat">下一轮BPM：{{nextBpm}}</view>
    </view>

    <!-- Result -->
    <view class="result" wx:if="{{!isRunning && hasResult}}">
      <view class="resultLine">本轮结果：命中率 {{accuracyPct}}%</view>

      <view wx:if="{{mode==='stage1'}}">
        <view class="resultLine" wx:if="{{passed}}">
          ✅ Stage1 达标：已解锁 Stage2
        </view>
        <view class="resultLine" wx:if="{{!passed}}">
          ❗未达标（需要 ≥ 70%）
        </view>
      </view>

      <view class="btnRow">
        <button class="btn" bindtap="onExport" disabled="{{logs.length===0}}">导出数据（复制）</button>
        <button class="btn" bindtap="onReset">清空结果</button>
      </view>
    </view>
  </view>

  <view class="footer">
    <view>导出字段：beatTime, tapTime, errMs, hit, bpm, tolMs, mode, bpmCur, range, acc10, meanErr10</view>
  </view>
</view>
