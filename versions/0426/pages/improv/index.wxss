/* pages/melody-maker/index.wxss */

.melody-content {
  display: flex;
  flex-direction: column;
  height: calc(100vh - 88rpx);
  box-sizing: border-box;
  padding: 20rpx 24rpx 24rpx;
  gap: 20rpx;
}

/* 网格滚动区 */
.grid-scroll {
  flex: 1;
  min-height: 0;
  overflow-x: auto;
}

.grid-container {
  display: inline-block;
  min-width: 100%;
  min-height: 100%;
  padding-bottom: 8rpx;
  box-sizing: border-box;
}

.grid-header {
  display: flex;
  margin-bottom: 20rpx;
}

.note-label-col {
  width: 84rpx;
  flex-shrink: 0;
}

.step-label {
  width: 52rpx;
  flex-shrink: 0;
  text-align: center;
  font-size: 20rpx;
  color: var(--color-muted-foreground);
}

/* 网格行 */
.grid-row {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.note-label {
  width: 84rpx;
  flex-shrink: 0;
  font-size: var(--text-xs);
  color: var(--color-muted-foreground);
  font-weight: 500;
}

.note-cell {
  width: 52rpx;
  height: 52rpx;
  flex-shrink: 0;
  margin-right: 6rpx;
  background-color: rgba(255, 252, 253, 0.98);
  border: 2rpx solid rgba(123, 128, 152, 0.16);
  border-radius: 14rpx;
  box-sizing: border-box; /* 保证边框不会影响外部尺寸 */
  /* 避免使用 transition: all 触发布局相关属性动画 */
  transition: background-color 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
}

.note-active {
  background-color: rgba(143, 149, 216, 0.92);
  border-color: rgba(143, 149, 216, 0.78);
  box-shadow: 0 6rpx 16rpx rgba(143, 149, 216, 0.26);
}

.note-playing {
  /* 仅改变颜色/阴影高亮，不改变尺寸，避免播放扫格造成抖动 */
  border-color: var(--color-primary);
  box-shadow: 0 0 0 6rpx rgba(143, 149, 216, 0.24);
}

/* 同时是已放置音符 + 当前播放列：保留原本的柔和阴影并叠加高亮圈 */
.note-active.note-playing {
  box-shadow: 0 0 0 6rpx rgba(143, 149, 216, 0.24),
              0 6rpx 16rpx rgba(143, 149, 216, 0.26);
}

/* 播放控制卡片 */
.control-card {
  background-color: rgba(255, 252, 253, 0.98);
  border-radius: var(--radius-xl);
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  border: 2rpx solid var(--color-border);
}

.control-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 18rpx;
}

.play-btn {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background-color: var(--color-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.play-btn:active {
  transform: scale(0.95);
}

.play-icon {
  width: 40rpx;
  height: 40rpx;
}

.speed-control {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.speed-label {
  font-size: var(--text-sm);
  color: var(--color-muted-foreground);
}

.speed-slider {
  flex: 1;
}

.speed-value {
  font-size: var(--text-sm);
  color: var(--color-foreground);
  font-weight: 500;
  width: 96rpx;
  text-align: right;
}

/* 控制按钮 */
.control-actions {
  display: flex;
  gap: 16rpx;
}

.action-btn {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx 24rpx;
  border-radius: var(--radius-lg);
  background-color: var(--color-secondary);
}

.action-btn:active {
  background-color: var(--color-secondary-pressed);
}

.action-btn-disabled {
  opacity: 0.5;
}

.action-icon {
  width: 32rpx;
  height: 32rpx;
}

.action-text {
  font-size: var(--text-sm);
  color: var(--color-secondary-foreground);
}

/* 底部按钮 */
.bottom-actions {
  display: flex;
  gap: 16rpx;
}

.btn-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 8rpx;
}

.btn {
  display: flex;
  align-items: center;
  justify-content: center;
}

/* Modal 样式 */
.work-name-input {
  width: 100%;
  padding: 24rpx 32rpx;
  background-color: var(--color-input-background);
  border-radius: var(--radius-lg);
  border: 2rpx solid var(--color-border);
  font-size: var(--text-base);
}

.work-info-card {
  background-color: rgba(247, 240, 239, 0.9);
  border-radius: var(--radius-lg);
  padding: 32rpx;
  text-align: center;
}

.work-info-name {
  display: block;
  font-size: var(--text-base);
  font-weight: 500;
  color: var(--color-foreground);
  margin-bottom: 8rpx;
}

.work-info-count {
  display: block;
  font-size: var(--text-sm);
  color: var(--color-muted-foreground);
}

/* 预览卡片 */
.preview-card {
  background-color: rgba(255, 252, 253, 0.98);
  border-radius: var(--radius-lg);
  padding: 24rpx;
  border: 2rpx solid var(--color-border);
}

.preview-title {
  display: block;
  font-size: var(--text-xs);
  color: var(--color-muted-foreground);
  margin-bottom: 16rpx;
}

.preview-grid {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.preview-row {
  display: flex;
  gap: 4rpx;
}

.preview-cell {
  width: 16rpx;
  height: 16rpx;
  background-color: rgba(247, 240, 239, 0.9);
  border-radius: 4rpx;
}

.preview-cell-active {
  background-color: var(--color-primary);
}

.success-badge {
  background-color: rgba(149, 205, 175, 0.16);
  border-radius: var(--radius-lg);
  padding: 24rpx;
  border: 2rpx solid rgba(149, 205, 175, 0.28);
  text-align: center;
  font-size: var(--text-sm);
  color: var(--color-success);
}

/* 复用通用样式 */
.app-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 40rpx;
  background-color: rgba(255, 252, 253, 0.98);
  min-height: 88rpx;
}

.app-bar-title {
  font-size: var(--text-xl);
  font-weight: 500;
  color: var(--color-foreground);
  flex: 1;
  text-align: center;
}

.icon-btn {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
}

.icon-btn:active {
  background-color: rgba(247, 240, 239, 0.9);
}

.icon {
  width: 48rpx;
  height: 48rpx;
}

.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(68, 80, 106, 0.18);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  padding: 32rpx;
}

.modal-content {
  background-color: rgba(255, 252, 253, 0.98);
  border-radius: var(--radius-2xl);
  max-width: 680rpx;
  width: 100%;
  box-shadow: 0 16rpx 64rpx rgba(108, 100, 138, 0.18);
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 40rpx;
  border-bottom: 2rpx solid var(--color-border);
}

.modal-title {
  font-size: var(--text-2xl);
  font-weight: 500;
  color: var(--color-foreground);
}

.modal-close {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
}

.modal-close:active {
  background-color: rgba(247, 240, 239, 0.9);
}

.modal-body {
  padding: 40rpx;
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.modal-message {
  font-size: var(--text-base);
  color: var(--color-muted-foreground);
}

.modal-footer {
  display: flex;
  gap: 24rpx;
  padding: 0 40rpx 40rpx;
}

.btn-half {
  flex: 1;
}
