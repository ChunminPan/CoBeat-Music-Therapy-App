.page { padding: 18px; background: var(--color-background); }

.page > .topBpmCard:first-child,
.page > .modeRow:first-child,
.page > .helpEntryRow + .topBpmCard,
.page > .helpEntryRow + .modeRow { margin-top: 0; }

.topBpmCard {
  margin-top: 12px;
  padding: 12px 14px;
  border-radius: 14px;
  background: rgba(248, 243, 249, 0.96);
  border: 1px solid rgba(143, 149, 216, 0.18);
}

.topBpmHeader {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
}

.topBpmTitle {
  font-size: 15px;
  font-weight: 700;
  color: var(--color-foreground);
}

.topBpmValue {
  margin-top: 8px;
  margin-bottom: 6px;
  font-size: 22px;
  font-weight: 700;
  color: var(--color-foreground);
}

.topBpmBadge {
  padding: 4px 10px;
  border-radius: 999px;
  font-size: 11px;
  font-weight: 700;
}

.topBpmBadge.locked {
  background: rgba(238, 233, 241, 0.9);
  color: #80869D;
}

.topBpmBadge.unlocked {
  background: rgba(149, 205, 175, 0.2);
  color: #4E8D6A;
}

.modeRow { display: flex; gap: 10px; margin-top: 12px; }
.modeBtn {
  flex: 1;
  border-radius: 999px;
  font-size: 14px;
  background: rgba(255, 252, 253, 0.96);
  border: 1px solid rgba(143, 149, 216, 0.16);
  color: #67708A;
}

.modeBtn.active {
  background: var(--color-primary);
  color: var(--color-primary-foreground);
  border-color: var(--color-primary);
  box-shadow: 0 10px 20px rgba(143, 149, 216, 0.18);
}
.active { font-weight: 700; }

.card { margin-top: 14px; padding: 14px; background: rgba(255, 252, 253, 0.98); border: 1px solid rgba(123, 128, 152, 0.14); border-radius: 14px; box-shadow: 0 10px 22px rgba(108, 100, 138, 0.08); }

.row { display: flex; align-items: center; justify-content: space-between; margin-bottom: 8px; }
.label { font-weight: 600; color: var(--color-foreground); }
.tip { color: #7D8398; font-size: 12px; margin-top: 6px; }

.metronome { display: flex; flex-direction: column; align-items: center; margin: 16px 0 10px; }
.metronomeStage {
  width: 130px;
  height: 130px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: transparent;
}

/* NOTE: 已移除圆形节拍器的 pulse 动画。
   这里原本残留了 @keyframes 的片段（45%/100%/}），会导致 WXSS 编译报错。
   保留注释占位以避免误删回归。 */

.hint { margin-top: 10px; color: #7D8398; font-size: 12px; }

.btnRow { display: flex; gap: 10px; margin-top: 10px; }
.btn {
  flex: 1;
  border-radius: 16px;
  background: rgba(255, 252, 253, 0.98);
  color: #616A84;
  border: 1px solid rgba(123, 128, 152, 0.14);
}

.btnPrimary {
  background: var(--color-primary);
  color: var(--color-primary-foreground);
  border-color: var(--color-primary);
}

button.btn[disabled],
button.tapBtn[disabled],
button.modeBtn[disabled],
.rulesConfirmBtn[disabled],
.btnPrimary[disabled] {
  background: var(--color-disabled) !important;
  color: var(--color-disabled-foreground) !important;
  border-color: transparent !important;
  opacity: 1;
}

.tapArea { margin-top: 14px; }
.tapBtn {
  height: 52px;
  font-size: 16px;
  border-radius: 18px;
  background: rgba(241, 199, 173, 0.36);
  color: var(--color-foreground);
  border: 1px solid rgba(231, 163, 143, 0.28);
  transition: all 0.15s ease;
  position: relative;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  padding: 10px 15px;
}

.tapBtn:active {
  transform: scale(0.97);
}

.tapBtn.active {
  background: #F4D1BE;
  border-color: #E7A38F;
  box-shadow: 0 0 0 6px rgba(231, 163, 143, 0.22);
}

.tapBtn.tapFlash {
  transform: scale(0.985);
}

.tapBtnLabel {
  font-size: 16px;
  font-weight: 700;
  color: var(--color-foreground);
}

.tapBtnHint {
  font-size: 14px;
  color: #6E7893;
  margin-bottom: 4px;
}

.tapBtnFeedback {
  position: absolute;
  top: 10px;
  left: 15px;
  z-index: 3;
  padding: 4px 8px;
  border-radius: 999px;
  font-size: 12px;
  font-weight: 700;
  color: var(--color-foreground);
  background: rgba(255, 252, 253, 0.94);
  box-shadow: 0 6px 14px rgba(108, 100, 138, 0.12);
  opacity: 0;
  transition: opacity 0.15s ease;
}

.tapBtnFeedback.show {
  opacity: 1;
}

.tapBtnFeedback.ack {
  color: #6B75BC;
}

.tapBtnFeedback.hit {
  color: #5B936E;
}

.tapBtnFeedback.miss {
  color: #B46A7B;
}

.tapBtnPulse {
  position: absolute;
  width: 80px;
  height: 80px;
  border-radius: 50%;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  background: rgba(231, 163, 143, 0.16);
  border: 2px solid rgba(231, 163, 143, 0.28);
  z-index: 2;
}

.stats { margin-top: 12px; display: flex; flex-wrap: wrap; gap: 10px; }
.stat { font-size: 12px; color: #566179; padding: 6px 10px; border: 1px solid rgba(123, 128, 152, 0.14); border-radius: 999px; background: rgba(255, 252, 253, 0.9); }

.result { margin-top: 14px; padding-top: 10px; border-top: 1px solid rgba(123, 128, 152, 0.14); }
.resultLine { margin-top: 6px; }

.footer { margin-top: 14px; color: #8A90A6; font-size: 11px; line-height: 16px; }

/* ===== Monkey Drummer (原创简化版，WXML+WXSS 绘制) ===== */
.monkeyWrap {
  width: 86px;
  height: 86px;
  position: relative;
}

/* Drum */
.drum {
  position: absolute;
  left: 50%;
  bottom: 14px;
  width: 50px;
  height: 22px;
  transform: translateX(-50%);
  border-radius: 10px;
  background: #E7A38F;
  box-shadow: inset 0 -3px 0 rgba(0,0,0,0.18);
}
.drumHead {
  position: absolute;
  left: 4px;
  top: 2px;
  width: 42px;
  height: 10px;
  border-radius: 999px;
  background: #F3E2BF;
  opacity: 0.95;
}

/* Monkey base */
.monkey {
  position: absolute;
  left: 50%;
  top: 12px;
  width: 54px;
  height: 52px;
  transform: translateX(-50%);
}

.head {
  position: absolute;
  left: 50%;
  top: 0;
  width: 40px;
  height: 34px;
  transform: translateX(-50%);
  border-radius: 18px;
  background: #9B7B65;
  box-shadow: inset 0 -2px 0 rgba(0,0,0,0.12);
}

.ear {
  position: absolute;
  top: 8px;
  width: 14px;
  height: 14px;
  border-radius: 50%;
  background: #9B7B65;
}
.earL { left: -6px; }
.earR { right: -6px; }

.face {
  position: absolute;
  left: 50%;
  top: 10px;
  width: 30px;
  height: 22px;
  transform: translateX(-50%);
  border-radius: 12px;
  background: #F3E2BF;
}

.eye {
  position: absolute;
  top: 7px;
  width: 4px;
  height: 4px;
  border-radius: 50%;
  background: #4F4B52;
}
.eyeL { left: 8px; }
.eyeR { right: 8px; }

.mouth {
  position: absolute;
  left: 50%;
  bottom: 5px;
  width: 10px;
  height: 6px;
  transform: translateX(-50%);
  border-bottom: 2px solid rgba(79, 75, 82, 0.35);
  border-radius: 0 0 10px 10px;
}

.body {
  position: absolute;
  left: 50%;
  top: 28px;
  width: 36px;
  height: 24px;
  transform: translateX(-50%);
  border-radius: 14px;
  background: #9B7B65;
  box-shadow: inset 0 -2px 0 rgba(0,0,0,0.12);
}

/* Arms + sticks */
.arm {
  position: absolute;
  top: 24px;
  width: 18px;
  height: 10px;
  border-radius: 999px;
  background: #9B7B65;
  transform-origin: 3px 5px;
}

.armL {
  left: 10px;
  transform: rotate(-20deg) translateY(0);
}
.armR {
  right: 10px;
  transform: rotate(20deg) translateY(0);
}

.stick {
  position: absolute;
  left: 12px;
  top: 4px;
  width: 18px;
  height: 3px;
  border-radius: 999px;
  background: #DCC8A8;
  box-shadow: 0 1px 0 rgba(0,0,0,0.12);
}



