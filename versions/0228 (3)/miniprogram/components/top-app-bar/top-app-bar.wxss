.bar {
  height: 104rpx;
  padding: 0 32rpx;
  background: #fff;
  display: flex;
  align-items: center;
  border-bottom: 1px solid #eee;
}

.left, .right {
  width: 180rpx;
  display: flex;
  align-items: center;
}

.right { justify-content: flex-end; gap: 16rpx; }

.center {
  flex: 1;
  display: flex;
  justify-content: center;
}

.title {
  font-size: 32rpx;
  font-weight: 700;
}

.icon-btn {
  width: 88rpx;
  height: 88rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.icon-btn:active { background: #f2f2f2; }
