.page { height: 100vh; display: flex; flex-direction: column; }
.content { flex: 1; padding: 24rpx 32rpx; }

.p24 { padding: 48rpx; margin-bottom: 20rpx; }

.block { display: block; }
.small { font-size: 26rpx; }
.xsmall { font-size: 22rpx; }
.mt16 { margin-top: 32rpx; }
.mb16 { margin-bottom: 32rpx; }

.row { display: flex; align-items: center; }
.gap8 { gap: 16rpx; }

.badge {
  width: 44rpx; height: 44rpx; border-radius: 999rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 24rpx;
}
.badge.primary { background: rgba(37,99,235,0.12); }
.badge.success { background: rgba(34,197,94,0.12); }
.badge.muted { background: rgba(107,114,128,0.12); }

.locked { opacity: 0.75; }

.tip {
  padding: 28rpx;
  border-radius: 16rpx;
  background: rgba(37,99,235,0.06);
  border: 1px solid rgba(37,99,235,0.22);
}
.tip-text { color: #2563eb; font-size: 24rpx; text-align: center; display: block; }
