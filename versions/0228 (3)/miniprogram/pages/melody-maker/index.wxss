.page { height: 100vh; display: flex; flex-direction: column; }
.wrap { padding: 24rpx 32rpx; }
.p24 { padding: 48rpx; }
.block { display: block; }
.small { font-size: 26rpx; }

.grid {
  display: grid;
  grid-template-columns: repeat(8, 1fr);
  gap: 12rpx;
  margin: 24rpx 0;
}

.cell {
  height: 72rpx;
  border-radius: 12rpx;
  border: 1px solid #e5e7eb;
  background: #fff;
}
.cell.on {
  background: rgba(37,99,235,0.18);
  border-color: rgba(37,99,235,0.55);
}

.btn { border-radius: 16rpx; font-weight: 700; height: 96rpx; line-height: 96rpx; font-size: 30rpx; }
.secondary { background: #f3f4f6; color: #111; }
