.page { height: 100vh; display: flex; flex-direction: column; }

.topbar {
  height: 104rpx;
  padding: 0 32rpx;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1px solid #eee;
}

.content { flex: 1; padding: 24rpx 32rpx; }

.p24 { padding: 48rpx; margin-bottom: 20rpx; }
.p20 { padding: 40rpx; margin-bottom: 20rpx; }

.row { display: flex; align-items: center; }
.between { justify-content: space-between; }
.col { display: flex; flex-direction: column; gap: 8rpx; }
.gap8 { gap: 16rpx; }
.mb16 { margin-bottom: 32rpx; }
.mb12 { margin-bottom: 24rpx; }

.small { font-size: 24rpx; }
.bold { font-weight: 700; }
.right { margin-left: auto; }

.tap:active { background: #f2f2f2; }

.icon-btn {
  width: 88rpx; height: 88rpx; border-radius: 999rpx;
  display: flex; align-items: center; justify-content: center;
}
.icon-btn:active { background: #f2f2f2; }

.icon-circle {
  width: 112rpx; height: 112rpx; border-radius: 999rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 40rpx;
}
.icon-circle.primary { background: rgba(37,99,235,0.12); }
.icon-circle.success { background: rgba(34,197,94,0.12); }

.stack { display: flex; flex-direction: column; gap: 14rpx; }
