.page { height: 100vh; display: flex; flex-direction: column; }
.wrap { padding: 24rpx 32rpx; }
.p24 { padding: 48rpx; }

.block { display: block; }
.small { font-size: 26rpx; }

.stat { display: flex; gap: 20rpx; margin: 28rpx 0; }
.stat-item {
  flex: 1;
  padding: 24rpx;
  border-radius: 16rpx;
  border: 1px solid #eee;
}
.big { font-size: 44rpx; font-weight: 800; display: block; margin-top: 8rpx; }

.btnrow { display: flex; gap: 16rpx; margin-top: 16rpx; }
.btn {
  border-radius: 16rpx;
  font-weight: 700;
}
.primary { background: #2563eb; color: #fff; }
.secondary { background: #f3f4f6; color: #111; }
.tap { margin-top: 16rpx; background: #111; color: #fff; }
