.intake-page {
  min-height: 100vh;
  background: #f7f8fb;
}

.intake-content {
  padding-bottom: 80rpx;
}

.intro-card,
.form-card {
  background: #ffffff;
}

.page-title {
  display: block;
  font-size: 42rpx;
  font-weight: 700;
  color: #2f3442;
  margin-bottom: 16rpx;
}

.page-desc {
  display: block;
  font-size: 28rpx;
  line-height: 1.7;
  color: #697083;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #2f3442;
}

.section-tag {
  font-size: 24rpx;
  color: #7a8296;
  background: #f1f3f8;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
}

.section-tag-required {
  color: #6e7fbe;
  background: #eef2ff;
}

.form-item {
  padding: 28rpx 0;
  border-top: 2rpx solid rgba(138, 141, 154, 0.12);
}

.form-item:first-of-type {
  border-top: none;
  padding-top: 0;
}

.form-label {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #3a3d4a;
  margin-bottom: 20rpx;
}

.long-label {
  line-height: 1.7;
}

.text-input {
  width: 100%;
  min-height: 88rpx;
  box-sizing: border-box;
  border: 2rpx solid rgba(138, 141, 154, 0.2);
  border-radius: 24rpx;
  padding: 0 26rpx;
  font-size: 30rpx;
  background: #fbfcff;
}

.radio-group {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx 28rpx;
}

.vertical-group {
  flex-direction: column;
  gap: 20rpx;
}

.radio-item {
  display: flex;
  align-items: center;
  color: #4b5160;
  font-size: 28rpx;
}

.radio-item text {
  margin-left: 10rpx;
}

.form-hint {
  display: block;
  font-size: 24rpx;
  color: #8a90a0;
  margin-top: 12rpx;
}

.collapsed-tip {
  padding-top: 8rpx;
}

.collapsed-text {
  display: block;
  color: #8a90a0;
  font-size: 26rpx;
  line-height: 1.7;
}

.submit-wrap {
  padding-bottom: 20rpx;
}

.submit-btn {
  width: 100%;
  min-height: 96rpx;
  line-height: 96rpx;
  border-radius: 28rpx;
  font-size: 32rpx;
}
