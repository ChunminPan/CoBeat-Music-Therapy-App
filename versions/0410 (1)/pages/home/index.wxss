/* pages/home/index.wxss */

.app-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 40rpx;
  background-color: var(--color-card);
  min-height: 88rpx;
}

.app-bar-title {
  font-size: var(--text-2xl);
  font-weight: 500;
  color: var(--color-foreground);
}

.icon-btn {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
}

.icon-btn:active {
  background-color: var(--color-accent);
}

.icon {
  width: 48rpx;
  height: 48rpx;
}

.icon-small {
  width: 40rpx;
  height: 40rpx;
}

.icon-large {
  width: 56rpx;
  height: 56rpx;
}

/* 特色卡片 */
.feature-card {
  margin-bottom: 40rpx;
}

.feature-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 32rpx;
}

.feature-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.feature-title {
  font-size: var(--text-2xl);
  font-weight: 500;
  color: var(--color-foreground);
  margin-bottom: 16rpx;
}

.feature-subtitle {
  font-size: var(--text-sm);
  color: var(--color-muted-foreground);
}

.feature-icon {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.feature-icon-primary {
  background-color: rgba(139, 159, 219, 0.1);
}

.feature-icon-success {
  background-color: rgba(143, 212, 168, 0.1);
}

/* 最近记录卡片 */
.recent-card {
  margin-top: 40rpx;
}

.recent-card:active {
  background-color: var(--color-accent);
}

.recent-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.recent-title {
  font-size: var(--text-lg);
  font-weight: 500;
  color: var(--color-foreground);
}

.recent-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.recent-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  font-size: var(--text-sm);
}

.recent-icon {
  width: 32rpx;
  height: 32rpx;
}

.recent-label {
  color: var(--color-muted-foreground);
}

.recent-value {
  color: var(--color-foreground);
  font-weight: 500;
  flex: 1;
}

.recent-time {
  color: var(--color-muted-foreground);
  font-size: var(--text-xs);
}

.recent-empty {
  padding: 16rpx 0;
}

.recent-empty text {
  font-size: var(--text-sm);
}

/* Tab切换样式 */
.tab-container {
  display: flex;
  border-bottom: 1px solid var(--color-border);
  margin-bottom: 24rpx;
}

.tab-item {
  flex: 1;
  padding: 16rpx 0;
  text-align: center;
  position: relative;
}

.tab-text {
  font-size: var(--text-sm);
  color: var(--color-muted-foreground);
}

.tab-active .tab-text {
  color: var(--color-primary);
  font-weight: 500;
}

.tab-active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 20%;
  width: 60%;
  height: 4rpx;
  background-color: var(--color-primary);
  border-radius: 2rpx;
}
