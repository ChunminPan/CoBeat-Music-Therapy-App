<!-- pages/home/index.wxml -->
<view class="container">
  <!-- Top App Bar -->
  <view class="app-bar">
    <text class="app-bar-title">Music Therapy</text>
    <view class="icon-btn" bindtap="onSettings">
      <image class="icon" src="/images/settings.png" mode="aspectFit" />
    </view>
  </view>

  <!-- 主内容区 -->
  <view class="page-content">
    
    <!-- 卡片 A：节拍训练 -->
    <view class="card feature-card">
      <view class="feature-header">
        <view class="feature-info">
          <text class="feature-title">节拍训练</text>
          <text class="feature-subtitle">跟着节拍点一点</text>
        </view>
        <view class="feature-icon feature-icon-primary">
          <image class="icon-large" src="/images/drum.png" mode="aspectFit" />
        </view>
      </view>
      <view class="btn btn-primary btn-large" bindtap="onStartTraining">
        开始训练
      </view>
    </view>

    <!-- 卡片 B：即兴创作 -->
    <view class="card feature-card">
      <view class="feature-header">
        <view class="feature-info">
          <text class="feature-title">即兴创作</text>
          <text class="feature-subtitle">点格子做旋律</text>
        </view>
        <view class="feature-icon feature-icon-success">
          <image class="icon-large" src="/images/grid.png" mode="aspectFit" />
        </view>
      </view>
      <view class="btn btn-primary btn-large" bindtap="onStartCreation">
        开始创作
      </view>
    </view>

    <!-- 最近记录/我的作品 -->
    <view class="card-small recent-card" bindtap="onViewRecords">
      <view class="recent-header">
        <text class="recent-title">最近记录</text>
        <image class="icon-small" src="/images/music.png" mode="aspectFit" />
      </view>

      <view wx:if="{{hasRecentData}}" class="recent-list">
        <view wx:if="{{recentTraining.hasData}}" class="recent-item">
          <image class="recent-icon" src="/images/clock.png" mode="aspectFit" />
          <text class="recent-label">训练</text>
          <text class="recent-value">命中率 {{recentTraining.hitRate}}%</text>
          <text class="recent-time">{{recentTraining.date}}</text>
        </view>
        <view wx:if="{{recentWork.hasData}}" class="recent-item">
          <image class="recent-icon" src="/images/music.png" mode="aspectFit" />
          <text class="recent-label">作品</text>
          <text class="recent-value">{{recentWork.name}}</text>
          <text class="recent-time">{{recentWork.date}}</text>
        </view>
      </view>

      <view wx:else class="recent-empty">
        <text class="text-muted">还没有记录，开始你的第一次练习吧！</text>
      </view>
    </view>

  </view>
</view>
