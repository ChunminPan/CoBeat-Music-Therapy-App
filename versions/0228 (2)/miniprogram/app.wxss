/**
 * 全局样式
 * 音乐疗法训练 App - 儿童友好设计
 */

/* 全局变量定义 */
page {
  /* 色彩系统 */
  --color-background: #F5F6F8;
  --color-foreground: #3A3D4A;
  --color-card: #FFFFFF;
  --color-card-foreground: #3A3D4A;
  
  /* 主色 - 柔和蓝紫色 */
  --color-primary: #8B9FDB;
  --color-primary-foreground: #FFFFFF;
  --color-primary-pressed: #7A8DC9;
  
  /* 次要按钮 - 浅灰 */
  --color-secondary: #E8EAED;
  --color-secondary-foreground: #5A5D6B;
  --color-secondary-pressed: #D8DADD;
  
  /* 成功状态 - 柔和绿色 */
  --color-success: #8FD4A8;
  --color-success-foreground: #FFFFFF;
  --color-success-light: #C8E6D4;
  
  /* 未命中/失败 - 柔和灰色 */
  --color-miss: #C4C7D0;
  --color-miss-foreground: #8A8D9A;
  
  /* 禁用状态 */
  --color-disabled: #E8EAED;
  --color-disabled-foreground: #B8BAC0;
  
  --color-muted: #E8EAED;
  --color-muted-foreground: #8A8D9A;
  --color-accent: #F0F1F3;
  
  /* 警告色 */
  --color-warning: #F5C08F;
  
  /* 边框 */
  --color-border: rgba(138, 141, 154, 0.2);
  
  /* 圆角 */
  --radius-sm: 24rpx;
  --radius-md: 32rpx;
  --radius-lg: 40rpx;
  --radius-xl: 48rpx;
  --radius-2xl: 64rpx;
  
  /* 字体大小 */
  --text-xs: 24rpx;
  --text-sm: 28rpx;
  --text-base: 32rpx;
  --text-lg: 36rpx;
  --text-xl: 48rpx;
  --text-2xl: 64rpx;
  --text-3xl: 80rpx;
  --text-4xl: 112rpx;
  
  background-color: var(--color-background);
  color: var(--color-foreground);
  font-family: -apple-system-font, "Helvetica Neue", Helvetica, sans-serif;
  font-size: var(--text-base);
  line-height: 1.6;
}

/* 通用布局类 */
.container {
  width: 100%;
  min-height: 100vh;
  background-color: var(--color-background);
}

.page-content {
  padding: 40rpx;
}

/* 卡片 */
.card {
  background-color: var(--color-card);
  border-radius: var(--radius-2xl);
  padding: 48rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  border: 2rpx solid var(--color-border);
}

.card-small {
  background-color: var(--color-card);
  border-radius: var(--radius-xl);
  padding: 40rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  border: 2rpx solid var(--color-border);
}

/* 按钮基础样式 */
.btn {
  border-radius: var(--radius-xl);
  padding: 24rpx 48rpx;
  min-height: 88rpx;
  font-size: var(--text-base);
  font-weight: 500;
  text-align: center;
  transition: all 0.2s ease-out;
  border: none;
}

.btn-primary {
  background-color: var(--color-primary);
  color: var(--color-primary-foreground);
}

.btn-primary:active {
  background-color: var(--color-primary-pressed);
  transform: scale(0.98);
}

.btn-secondary {
  background-color: var(--color-secondary);
  color: var(--color-secondary-foreground);
}

.btn-secondary:active {
  background-color: var(--color-secondary-pressed);
  transform: scale(0.98);
}

.btn-large {
  padding: 32rpx 64rpx;
  min-height: 112rpx;
}

.btn-disabled {
  background-color: var(--color-disabled);
  color: var(--color-disabled-foreground);
}

/* 文本样式 */
.text-primary {
  color: var(--color-primary);
}

.text-success {
  color: var(--color-success);
}

.text-muted {
  color: var(--color-muted-foreground);
}

.text-foreground {
  color: var(--color-foreground);
}

/* 间距 */
.mt-20 { margin-top: 40rpx; }
.mt-30 { margin-top: 60rpx; }
.mb-20 { margin-top: 40rpx; }
.mb-30 { margin-bottom: 60rpx; }

/* Flex 布局 */
.flex {
  display: flex;
}

.flex-col {
  display: flex;
  flex-direction: column;
}

.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.flex-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.flex-1 {
  flex: 1;
}

/* 圆角 */
.rounded-full {
  border-radius: 9999rpx;
}

/* 阴影 */
.shadow {
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}
